{
  "name": "interlude-studio-back",
  "version": "1.0.0",
  "description": "API Lambda para o Interlude Studio",
  "main": "src/app.js",
  "scripts": {
    "dev": "nodemon --exec ts-node src/iniciarServidor.ts",
    "lint": "eslint .",
    "build": "node esbuild.config.js",
    "deploy": "npm run deploy:prod",
    "deploy:dev": "npm run build && serverless deploy --stage dev --region us-east-1",
    "deploy:prod": "npm run build && serverless deploy --stage prod --region us-east-1",
    "test": "jest --verbose",
    "test:watch": "jest --watch"
  },
  "author": "Giovani Murakami",
  "license": "ISC",
  "dependencies": {
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^8.3.2",
    "helmet": "^8.1.0",
    "mongoose": "^8.8.0",
    "pino": "^10.3.1",
    "rate-limit-mongo": "^2.3.2",
    "serverless-http": "^3.2.0",
    "uuid": "^10.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.0",
    "@types/express-mongo-sanitize": "^1.3.2",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.7.6",
    "@types/uuid": "^10.0.0",
    "esbuild": "^0.24.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.7",
    "pino-pretty": "^13.0.0",
    "serverless": "^4.4.6",
    "serverless-esbuild": "^1.57.0",
    "serverless-offline": "^14.5.0",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3"
  }
}
